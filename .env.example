# Napkin AI Director - Environment Variables
# Copy this file to .env and fill in your API keys

# Anthropic (Claude Opus 4.6) - Creative strategy + shot list
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Replicate - FLUX Kontext Max (turntable) + SAM2 (segmentation)
REPLICATE_API_TOKEN=r8_xxxxx

# World Labs (Marble API) - 3D world generation
WORLD_LABS_API_KEY=wl_xxxxx

# Luma AI (Dream Machine / Ray3) - Video generation
LUMA_API_KEY=luma_xxxxx

# Moonshot AI (Kimi K2.5) - Pipeline orchestrator + vision QA
KIMI_API_TOKEN=kimi_xxxxx

# FLUX API Key (if using separate FLUX endpoint)
FLUX_API_KEY=flux_xxxxx
